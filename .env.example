# Keha Inventory Planner — env template. Copy to .env (gitignored) and fill
# the blanks. Generated from the process.env reads in app/ (never from memory):
#   grep -rhoE "process\.env\.[A-Z0-9_]+" app | sort -u
# Secrets are write-only: never commit; in production use Railway variables.

# ── Shopify app ─────────────────────────────────────────
SHOPIFY_API_KEY=                    # client_id: prod 5bc85cc9e4ccd1c60e95950e85f306d8, dev 697e77fbed7c47e1736b0393ba94c9dd
SHOPIFY_API_SECRET=                 # secret · also the webhook HMAC key
SHOPIFY_APP_URL=https://inventory.keha.io
SHOPIFY_APP_HANDLE=keha-inventory   # must equal `handle` in shopify.app.toml
SHOPIFY_APP_GID=                    # optional · gid://shopify/App/<id> (skips one lookup in plan checks)
# Must equal [access_scopes] in shopify.app.toml (tests compare them).
SCOPES=read_products,read_inventory,read_locations,read_locales,read_reports,read_inventory_purchase_orders,write_inventory_transfers,write_discounts
SHOP_CUSTOM_DOMAIN=                 # optional · dev stores on a custom domain only

# ── Shopify App Pricing (plan checks through the Partner API) ──
SHOPIFY_PARTNER_ORG_ID=             # numeric id in the Partners URL
SHOPIFY_ORG_ID=                     # fallback for SHOPIFY_PARTNER_ORG_ID
SHOPIFY_PARTNER_API_TOKEN=          # secret · Partner API client with "Manage apps" (+ "View financials")

# ── Database (Railway Postgres, private network) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keha_inventory   # Railway: ${{Postgres.DATABASE_URL}} · connection_limit=10&pool_timeout=20 added unless set; behind PgBouncer add pgbouncer=true

# ── Crypto ──────────────────────────────────────────────
APP_ENCRYPTION_KEY=                 # secret · 32 bytes as 64 hex chars (AES-256-GCM for secrets at rest)

# ── Nova platform wiring (see NOVA-INTEGRATION-CONTRACT.md) ──
NOVA_API=
NOVA_INGRESS_HMAC_SECRET=           # secret · signs forwarded webhooks (X-Nova-Signature)
NOVA_INSTALL_CONFIRM_SECRET=        # secret · signs the install-confirm callback

# ── Scheduled jobs ──────────────────────────────────────
INVENTORY_CRON_SECRET=              # secret · bearer token for the /cron/* endpoints
INVENTORY_DISABLE_INTERNAL_CRON=    # set to 1 only if an external scheduler runs the jobs
WORKER_MODE=                        # all (default: pages + timers + job workers) | web (pages only) | worker (timers + jobs only)
INVENTORY_WORKERS=                  # jobs run at once per instance (default 2)

# ── Optional email provider — leave empty (owner decision 2026-10-18: notifications go through
#    Shopify Flow, purchase orders through the merchant's own email app; docs/OPERATIONS.md) ──
INVENTORY_EMAIL_API_URL=            # default https://api.resend.com/emails
INVENTORY_EMAIL_API_KEY=            # secret
INVENTORY_EMAIL_FROM=               # verified sender, e.g. "Keha <mail@keha.io>"

# ── Public pages (/privacy, /terms, landing) ──
INVENTORY_LEGAL_NAME=               # registered company name that operates the app
INVENTORY_SUPPORT_EMAIL=            # support / privacy contact (falls back to support@keha.io)
INVENTORY_LISTING_URL=              # App Store listing URL once live (falls back to https://keha.io/inventory)
