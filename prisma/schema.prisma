// Keha Inventory Planner — Prisma schema (PostgreSQL on Railway, private network).
// Schema changes go through real migrations (`prisma migrate`), never `db push`
// (spec §8, decision D6). Add-only: never drop or rename a column without a
// written impact note and Kanwar's approval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  /// The scheduler and every job list installed shops by session (DB scale #5).
  @@index([shop])
}

model NovaReferral {
  shop      String   @id
  ref       String
  createdAt DateTime @default(now())
}

model NovaOutbox {
  id            String    @id @default(cuid())
  kind          String
  url           String
  body          String
  headers       String    @default("{}") // JSON map of request headers (incl. X-Nova-Signature)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

/// Background work (DB scale #2, lib/jobs-shared): one row per (shop, kind) wanted — backfill,
/// nightly, compute, alerts. Claimed with FOR UPDATE SKIP LOCKED together with the shop's lease
/// (JobLease), so a job runs on one worker at a time and a shop's jobs one at a time; deleted
/// when done, unless asked for again while it ran (version moved).
model Job {
  id          String    @id
  shop        String
  kind        String
  runAt       DateTime
  /// Set while a worker holds it (extended every few minutes); past = free again (worker died).
  lockedUntil DateTime?
  lockedBy    String?
  /// Claims since it last finished; at MAX_ATTEMPTS it is set aside for an hour.
  attempts    Int       @default(0)
  lastError   String?
  /// Bumped by every enqueue: asked for again while running → re-queued when it finishes.
  version     Int       @default(0)
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([shop, kind])
  @@index([runAt])
}

/// A lease with expiry (DB scale #2): "shop:<domain>" is the per-shop job lock, "tick:<name>"
/// lets one instance run a shop-wide timer. Free when lockedUntil has passed.
model JobLease {
  key         String   @id
  /// The shop of a "shop:" lease (purged with it, I-3); null for timers.
  shop        String?
  owner       String
  lockedUntil DateTime
}

model UninstalledShop {
  shop          String    @id
  uninstalledAt DateTime  @default(now())
  purgedAt      DateTime?
}

model BillingState {
  shop             String    @id
  planCode         String?   // free | growth | pro
  interval         String?   // EVERY_30_DAYS | ANNUAL
  status           String?   // ACTIVE | PENDING | CANCELLED | FROZEN | DECLINED | EXPIRED
  subscriptionId   String?   // gid://shopify/AppSubscription/...
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OwnerEmailLog {
  id        String   @id @default(cuid())
  shop      String
  kind      String   // monday | alert …
  periodKey String   // e.g. 2026-10 (monthly), 2026-10-11 (daily), 2026-W41 (weekly)
  sentAt    DateTime @default(now())
  status    String   @default("SENT") // SENT | FAILED
  error     String?

  @@unique([shop, kind, periodKey])
  @@index([shop])
}

model PersonalDataAccessLog {
  id        String   @id @default(cuid())
  shop      String
  actor     String   // staff:<Shopify user id> | customer:<id> | system
  action    String   // view | export | import | share | gdpr_export | customer_view
  resource  String   // e.g. customer_data_request
  records   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([createdAt])
}

// ======================================================================
// Keha Inventory Planner data (spec §8). Every table carries `shop`
// (the purge key). Daily fact tables store only yesterday and older.
// Money: Decimal(18,2) for amounts, Decimal(18,4) for unit cost / price.
// ======================================================================

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  currency      String
  timezone      String    // IANA, e.g. Europe/Madrid
  locale        String    // primary shop locale (shopLocales)
  plan          String?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  settings      Json      @default("{}") // lead time, cycle, thresholds, alerts (spec §5.5)
  backfillState Json      @default("{}") // per-dataset months done / pct / lastError (spec §6.6)
  lastNightlyAt DateTime?
  /// When the stored first / last days (Variant.firstStockDay …, VariantLocationDays) were built
  /// from the facts; the sync keeps them current from then on. null = not built yet: readers use
  /// the facts (DB scale #3).
  factDaysAt    DateTime?
  /// Small integer key of the shop in the compact fact tables (SalesFact, StockMonth, SessionsFact).
  /// Assigned once (SERIAL), never reused: a reinstall after a purge gets a new number.
  num           Int       @unique @default(autoincrement())
}

model Location {
  id     String @id // gid://shopify/Location/<n>
  shop   String
  name   String
  active Boolean
  online Boolean // fulfillsOnlineOrders
  role   String  @default("other") // warehouse | store | other
  /// Merchant override for the online stock pool (spec §5.5, Pro). null = follow Shopify's fulfillsOnlineOrders.
  onlinePool Boolean?

  @@index([shop])
}

model Variant {
  id               String    @id // gid://shopify/ProductVariant/<n>
  shop             String
  productId        String
  productTitle     String
  variantTitle     String
  handle           String
  sku              String?
  vendor           String?
  productType      String?
  collections      String[]
  image            String?
  tracked          Boolean
  isBundle         Boolean   @default(false)
  status           String    // ACTIVE | DRAFT | ARCHIVED
  productCreatedAt DateTime? // for the "Dead" rule (product exists ≥ 90 days, spec §7.5)
  cost             Decimal?  @db.Decimal(18, 4)
  costCurrency     String?
  price            Decimal?  @db.Decimal(18, 4)
  supplierId       String?
  caseQty          Int?
  /// Merchant: "Don't reorder" (sell through, discontinued, one-off). Stays in stock numbers, never in orders.
  noReorder        Boolean   @default(false)
  /// The supplier's article / style code for the product (written to every variant of the product; size-grid PO documents).
  supplierCode     String?
  /// Shopify ProductVariant.inventoryPolicy: CONTINUE = keeps selling when out of stock (backorders owed); DENY / null = missed sales are lost.
  inventoryPolicy  String?
  /// First day with a StockDaily row at any location (DB scale #3; null = none or not known yet,
  /// filled lazily by compute — lib/sync/fact-days-shared).
  firstStockDay    DateTime? @db.Date
  /// First day with a channel-view SalesDaily row (locationKey "all").
  firstSaleDay     DateTime? @db.Date
  /// Last channel-view day with sold > 0.
  lastSaleDay      DateTime? @db.Date
  /// A Shopify bundle's components (ProductVariant.productVariantComponents): [{ variantId, quantity }].
  /// Bundle sales count as demand on each component (quantity per bundle); null = not a bundle / not read.
  bundleComponents Json?
  updatedAt        DateTime  @updatedAt

  @@index([shop])
  @@index([shop, productId])
}

/// LEGACY (DB scale "before 1,000", 2026-10-18): replaced by SalesFact. No longer written or read;
/// its rows were copied by the 20261018000000 migration. A later cleanup migration drops it.
model LegacySalesDaily {
  shop        String
  day         DateTime @db.Date
  variantId   String
  locationKey String // "online" | Location.id
  channel     String
  sold        Int
  returned    Int
  gross       Decimal  @db.Decimal(18, 2)

  @@id([shop, day, variantId, locationKey, channel])
  @@index([shop, variantId, day])
  @@map("SalesDaily")
}

/// LEGACY: replaced by StockMonth (see LegacySalesDaily).
model LegacyStockDaily {
  shop       String
  day        DateTime @db.Date
  variantId  String
  locationId String
  endUnits   Int
  outOfStock Boolean

  @@id([shop, day, variantId, locationId])
  @@index([shop, variantId, day])
  @@map("StockDaily")
}

/// Dictionary of the string keys the compact facts carry (location ids, "online", "all",
/// "pos:<name>", sales channels, traffic types) → small integers. 0 = "all", 1 = "online".
/// Append-only: a key keeps its number for ever (services/facts-store.server caches it).
model FactKey {
  num Int    @id @default(autoincrement())
  key String @unique
}

/// Daily sales (spec §8) in compact form: written and read only through services/facts-store.server,
/// which speaks the app's ids (GIDs, location keys, channel names). Two views as before (lib/sync/
/// facts-shared): location view (locNum = location key, channelNum = 0 "all") and channel view
/// (locNum = 0 "all"). variantNum = the number in gid://shopify/ProductVariant/<n>; gross in cents.
/// Monthly RANGE partitions on day (raw SQL, services/partitions.server); purged per partition.
model SalesFact {
  variantNum BigInt
  grossCents BigInt
  shopNum    Int
  day        DateTime @db.Date
  locNum     Int
  channelNum Int
  sold       Int
  returned   Int

  @@id([shopNum, variantNum, locNum, channelNum, day])
  @@index([shopNum, day])
}

/// Daily stock (ending units, out-of-stock flag per variant × location × day) as ONE row per
/// variant × location × month: endUnits[d] for day d of the month (NULL = no stock row that day),
/// bit d-1 of outMask = out of stock on day d, firstDay / lastDay = first / last day with data.
/// Read and written only through services/facts-store.server (which presents daily rows).
/// Monthly RANGE partitions on month.
model StockMonth {
  variantNum BigInt
  shopNum    Int
  month      DateTime @db.Date
  locNum     Int
  outMask    Int
  firstDay   Int      @db.SmallInt
  lastDay    Int      @db.SmallInt
  endUnits   Int[]

  @@id([shopNum, variantNum, locNum, month])
}

/// Per variant × location first stock day and last sale day (DB scale #3): what per-location
/// compute, the pool (a subset of the locations) and pool demand without a left-out store read
/// instead of scanning the facts' whole history. locationKey: a Location.id (stock rows and its
/// POS sales), "online" or "pos:<name>" (sales location view). Complete once Shop.factDaysAt is
/// set: no row / null = none. Maintained by the sync writes (services/sync/fact-days.server).
model VariantLocationDays {
  shop          String
  variantId     String
  locationKey   String
  firstStockDay DateTime? @db.Date
  lastSaleDay   DateTime? @db.Date

  @@id([shop, variantId, locationKey])
}

/// LEGACY: replaced by SessionsFact (see LegacySalesDaily).
model LegacySessionsDaily {
  shop        String
  day         DateTime @db.Date
  landingPath String
  trafficType String
  sessions    Int
  checkouts   Int

  @@id([shop, day, landingPath, trafficType])
  @@map("SessionsDaily")
}

/// Store visits by landing page and traffic type per day, compact (shopNum, trafficNum = FactKey).
/// Through services/facts-store.server only. Monthly RANGE partitions on day.
model SessionsFact {
  shopNum     Int
  day         DateTime @db.Date
  trafficNum  Int
  sessions    Int
  checkouts   Int
  landingPath String

  @@id([shopNum, day, landingPath, trafficNum])
}

/// Store-level daily totals for AOV and conversion (spec §7.6 sold-out page traffic).
model ShopDaily {
  shop   String
  day    DateTime @db.Date
  orders Int
  gross  Decimal  @db.Decimal(18, 2)

  @@id([shop, day])
}

model StockNow {
  shop       String
  variantId  String
  locationId String
  available  Int
  incoming   Int
  committed  Int
  onHand     Int
  updatedAt  DateTime @updatedAt

  @@id([shop, variantId, locationId])
}

model VariantMetric {
  shop         String
  variantId    String
  scope        String    // "online" | Location.id
  rate         Float?
  sigma        Float?
  daysLeft     Float?    // null when unknown OR never runs out — see neverRunsOut
  neverRunsOut Boolean   @default(false) // rate 0 with stock: daysLeft is infinite
  status       String
  role         String    // A | B | C
  orderQty     Int?
  orderBy      DateTime? @db.Date
  /// When this row's CONTENT last changed (compute writes only changed rows). The latest run of a
  /// scope is MetricRun.
  computedAt   DateTime
  inputs       Json
  /// Hash of every column above but computedAt (services/metric-writes.server): unchanged rows are not rewritten.
  contentHash  String?

  @@id([shop, variantId, scope])
  @@index([shop, status])
  @@index([shop, scope, status])
  @@index([shop, scope, orderBy])
}

/// The latest compute run per shop × scope (services/metric-writes.server): when it started and
/// finished, the rows it confirmed so far and how many of them changed. Freshness checks and the
/// order-plan cache read this, not VariantMetric.computedAt.
model MetricRun {
  shop       String
  scope      String
  startedAt  DateTime
  finishedAt DateTime?
  rows       Int       @default(0)
  changed    Int       @default(0)

  @@id([shop, scope])
}

model Action {
  id          String    @id @default(cuid())
  shop        String
  kind        String    // reorder | bridge | push | fix_falling | fix_sizes | fix_page | fix_returns | clear
  variantIds  String[]
  productId   String
  amount      Decimal   @db.Decimal(18, 2)
  currency    String
  reason      Json
  state       String    @default("open") // open | snoozed | dismissed | done
  snoozeUntil DateTime?
  /// One row per (kind, product); recomputes update it in place, e.g. "reorder:gid://shopify/Product/1".
  dedupeKey   String
  /// The figure when the merchant snoozed or dismissed it (spec §7.7: comes back at 2×).
  stateAmount Decimal?  @db.Decimal(18, 2)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shop, dedupeKey])
  @@index([shop, state])
}

model MoneyAtStake {
  shop           String
  day            DateTime @db.Date
  atRisk         Decimal? @db.Decimal(18, 2) // null = not enough data ("—"), never 0
  lost90         Decimal? @db.Decimal(18, 2)
  cashStuck      Decimal? @db.Decimal(18, 2)
  soldOutTraffic Decimal? @db.Decimal(18, 2)
  basis          Json

  @@id([shop, day])
}

model Supplier {
  id            String   @id @default(cuid())
  shop          String
  name          String
  email         String?  // AES-256-GCM ciphertext (app/lib/crypto.server.ts)
  leadTimeDays  Int
  /// Minimum units per variant line (MOQ per SKU).
  minOrder      Int?
  /// Minimum total units for the whole order (optional). Kanwar 2026-10-16: both fields.
  minOrderTotal Int?
  /// Default case pack for this supplier's lines (a variant's own caseQty wins).
  casePack      Int?
  /// Days from the supplier's ship date to stock arriving (sea/air freight). Arrival = confirmed ship date + transit.
  /// leadTimeDays stays the total from order to arrival.
  transitDays   Int?
  /// How often the merchant orders from this supplier (days; optional). null = the store's order cycle (Settings → Defaults).
  /// Order quantities cover lead time + this cycle; the supplier order builder gathers what is due within it.
  orderCycleDays Int?
  /// Minimum order value in the supplier's currency (optional; alongside the unit minimum).
  minOrderValue Decimal? @db.Decimal(18, 2)
  /// What minOrder applies to: "variant" (each size/colour) or "product" (each style, split across its variants by sales share).
  minOrderScope String   @default("variant")
  /// 1 unit of the supplier's currency in the store's currency (optional). Without it, costs stay in store currency.
  exchangeRate  Decimal? @db.Decimal(18, 6)
  currency      String?
  vendorMatch   String[]
  /// Hide unit costs on the supplier confirmation page (spec §14).
  hidePrices    Boolean  @default(false)
  /// Payment terms (Kanwar 2026-10-17): % paid when the order is placed; the rest at `balanceDue`.
  /// null (with balanceDue null) = everything paid when ordering.
  depositPercent Int?
  /// When the balance is paid: "ship" (supplier's ship date), "arrival", "after_arrival" (balanceDays after arrival).
  balanceDue    String?
  balanceDays   Int?
  /// Freight + duty as a % of the goods cost (e.g. 12). In cost lines and cash, never on the supplier's documents.
  landedCostPercent Decimal? @db.Decimal(6, 2)
  /// Measured lead time (received Keha / Shopify orders, models/suppliers.server refreshLeadStats):
  /// deliveries measured, average promised and actual days order → arrival, average delay, the
  /// standard deviation of the actual lead time, the share delivered on time, and when measured.
  leadSamples      Int?
  leadPromisedDays Float?
  leadActualDays   Float?
  leadDelayDays    Float?
  leadSigmaDays    Float?
  leadOnTimeShare  Float?
  leadStatsAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop])
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  shop              String
  supplierId        String?   // null for Shopify POs whose supplier isn't in Keha
  status            String    // draft | sent | confirmed | received | cancelled
  number            String
  lines             Json
  confirmToken      String    @unique
  /// The confirm link stops working 60 days after the order is sent (spec §14).
  confirmExpiresAt  DateTime?
  confirmedShipDate DateTime?
  /// Lead-time based arrival estimate until the supplier confirms.
  expectedDate      DateTime? @db.Date
  source            String    // keha | shopify
  shopifyPoId       String?
  supplierName      String?   // snapshot (Shopify POs: origin.supplierName)
  currency          String?
  note              String?
  sentAt            DateTime?
  receivedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([shop, number])
  @@unique([shop, shopifyPoId])
  @@index([shop, status])
}

model Scenario {
  id          String   @id @default(cuid())
  shop        String
  name        String
  /// black_friday | christmas | custom
  event       String   @default("custom")
  start       DateTime
  end         DateTime
  targetType  String   // growth | revenue | keep_pace
  targetValue Decimal  @db.Decimal(18, 2)
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
}

model CollectionGoal {
  shop         String
  collectionId String
  goalPct      Float

  @@id([shop, collectionId])
}

model ForecastSnapshot {
  shop      String
  month     DateTime @db.Date
  variantId String
  predicted Float
  actual    Float?

  @@id([shop, month, variantId])
}

/// Collection titles for filters, the planner and collection goals (Variant.collections holds ids).
model Collection {
  id     String @id // gid://shopify/Collection/<n>
  shop   String
  title  String
  handle String

  @@index([shop])
}

/// Monthly accuracy result (spec §7.8). The rows behind it live in ForecastSnapshot.
model AccuracyMonth {
  shop          String
  month         DateTime @db.Date
  /// Absolute % error of the store total (null = not enough data).
  storeErrorPct Float?
  /// Mean absolute % error over the top 20 variants by revenue (null = not enough data).
  top20ErrorPct Float?
  graded        Int
  computedAt    DateTime @default(now())

  @@id([shop, month])
}

/// A discount Keha created from a Clear action (spec J5). Cash freed is tracked against the baseline.
model Clearance {
  id            String    @id @default(cuid())
  shop          String
  actionId      String?
  discountId    String    // gid://shopify/DiscountAutomaticNode/<n> | gid://shopify/DiscountCodeNode/<n>
  kind          String    // automatic | code
  code          String?
  percent       Int
  productIds    String[]
  variantIds    String[]
  startsAt      DateTime
  endsAt        DateTime?
  /// Cash stuck in these variants when the discount was created.
  baselineCash  Decimal   @db.Decimal(18, 2)
  baselineUnits Int
  currency      String
  createdAt     DateTime  @default(now())

  @@index([shop])
}

/// Instant alerts sent (spec §11: at most 1 per product per 7 days).
model AlertLog {
  id        String   @id @default(cuid())
  shop      String
  productId String
  kind      String   // low_best_seller | sell_out
  channel   String   // email | slack
  sentAt    DateTime @default(now())

  @@index([shop, productId, sentAt])
}

/// A stock transfer Keha created in Shopify (spec J7, Pro).
model Transfer {
  id                    String   @id @default(cuid())
  shop                  String
  shopifyTransferId     String
  originLocationId      String
  destinationLocationId String
  lines                 Json
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())

  @@index([shop])
}

/// Per-product forecast choices the merchant made on the product page (R4 forecast quality):
/// "Don't cap" (no spike capping) and "Plan like…" (a new style with too little history uses
/// another product's or its product type's sales pace, × likePct %, until it has 28 days in stock).
model ForecastOverride {
  shop        String
  productId   String
  noCap       Boolean  @default(false)
  /// "product" | "productType"; null = no "Plan like".
  likeKind    String?
  /// The product id (likeKind "product") or the product type (likeKind "productType").
  likeRef     String?
  /// Percent of the reference pace (100 = the same pace).
  likePct     Int      @default(100)
  updatedAt   DateTime @updatedAt

  @@id([shop, productId])
}
