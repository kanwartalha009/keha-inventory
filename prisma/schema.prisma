// Keha Inventory Planner — Prisma schema (PostgreSQL on Railway, private network).
// Schema changes go through real migrations (`prisma migrate`), never `db push`
// (spec §8, decision D6). Add-only: never drop or rename a column without a
// written impact note and Kanwar's approval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model NovaReferral {
  shop      String   @id
  ref       String
  createdAt DateTime @default(now())
}

model NovaOutbox {
  id            String    @id @default(cuid())
  kind          String
  url           String
  body          String
  headers       String    @default("{}") // JSON map of request headers (incl. X-Nova-Signature)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

model UninstalledShop {
  shop          String    @id
  uninstalledAt DateTime  @default(now())
  purgedAt      DateTime?
}

model BillingState {
  shop             String    @id
  planCode         String?   // free | growth | pro
  interval         String?   // EVERY_30_DAYS | ANNUAL
  status           String?   // ACTIVE | PENDING | CANCELLED | FROZEN | DECLINED | EXPIRED
  subscriptionId   String?   // gid://shopify/AppSubscription/...
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OwnerEmailLog {
  id        String   @id @default(cuid())
  shop      String
  kind      String   // monday | alert …
  periodKey String   // e.g. 2026-10 (monthly), 2026-10-11 (daily), 2026-W41 (weekly)
  sentAt    DateTime @default(now())
  status    String   @default("SENT") // SENT | FAILED
  error     String?

  @@unique([shop, kind, periodKey])
  @@index([shop])
}

model PersonalDataAccessLog {
  id        String   @id @default(cuid())
  shop      String
  actor     String   // staff:<Shopify user id> | customer:<id> | system
  action    String   // view | export | import | share | gdpr_export | customer_view
  resource  String   // e.g. customer_data_request
  records   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([createdAt])
}

// ======================================================================
// Keha Inventory Planner data (spec §8). Every table carries `shop`
// (the purge key). Daily fact tables store only yesterday and older.
// Money: Decimal(18,2) for amounts, Decimal(18,4) for unit cost / price.
// ======================================================================

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  currency      String
  timezone      String    // IANA, e.g. Europe/Madrid
  locale        String    // primary shop locale (shopLocales)
  plan          String?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  settings      Json      @default("{}") // lead time, cycle, thresholds, alerts (spec §5.5)
  backfillState Json      @default("{}") // per-dataset months done / pct / lastError (spec §6.6)
  lastNightlyAt DateTime?
}

model Location {
  id     String @id // gid://shopify/Location/<n>
  shop   String
  name   String
  active Boolean
  online Boolean // fulfillsOnlineOrders
  role   String  @default("other") // warehouse | store | other
  /// Merchant override for the online stock pool (spec §5.5, Pro). null = follow Shopify's fulfillsOnlineOrders.
  onlinePool Boolean?

  @@index([shop])
}

model Variant {
  id               String    @id // gid://shopify/ProductVariant/<n>
  shop             String
  productId        String
  productTitle     String
  variantTitle     String
  handle           String
  sku              String?
  vendor           String?
  productType      String?
  collections      String[]
  image            String?
  tracked          Boolean
  isBundle         Boolean   @default(false)
  status           String    // ACTIVE | DRAFT | ARCHIVED
  productCreatedAt DateTime? // for the "Dead" rule (product exists ≥ 90 days, spec §7.5)
  cost             Decimal?  @db.Decimal(18, 4)
  costCurrency     String?
  price            Decimal?  @db.Decimal(18, 4)
  supplierId       String?
  caseQty          Int?
  /// Merchant: "Don't reorder" (sell through, discontinued, one-off). Stays in stock numbers, never in orders.
  noReorder        Boolean   @default(false)
  /// Shopify ProductVariant.inventoryPolicy: CONTINUE = keeps selling when out of stock (backorders owed); DENY / null = missed sales are lost.
  inventoryPolicy  String?
  updatedAt        DateTime  @updatedAt

  @@index([shop])
  @@index([shop, productId])
}

model SalesDaily {
  shop        String
  day         DateTime @db.Date
  variantId   String
  locationKey String // "online" | Location.id
  channel     String
  sold        Int
  returned    Int
  gross       Decimal  @db.Decimal(18, 2)

  @@id([shop, day, variantId, locationKey, channel])
  @@index([shop, variantId, day])
}

model StockDaily {
  shop       String
  day        DateTime @db.Date
  variantId  String
  locationId String
  endUnits   Int
  outOfStock Boolean

  @@id([shop, day, variantId, locationId])
  @@index([shop, variantId, day])
}

model SessionsDaily {
  shop        String
  day         DateTime @db.Date
  landingPath String
  trafficType String
  sessions    Int
  checkouts   Int

  @@id([shop, day, landingPath, trafficType])
}

/// Store-level daily totals for AOV and conversion (spec §7.6 sold-out page traffic).
model ShopDaily {
  shop   String
  day    DateTime @db.Date
  orders Int
  gross  Decimal  @db.Decimal(18, 2)

  @@id([shop, day])
}

model StockNow {
  shop       String
  variantId  String
  locationId String
  available  Int
  incoming   Int
  committed  Int
  onHand     Int
  updatedAt  DateTime @updatedAt

  @@id([shop, variantId, locationId])
}

model VariantMetric {
  shop         String
  variantId    String
  scope        String    // "online" | Location.id
  rate         Float?
  sigma        Float?
  daysLeft     Float?    // null when unknown OR never runs out — see neverRunsOut
  neverRunsOut Boolean   @default(false) // rate 0 with stock: daysLeft is infinite
  status       String
  role         String    // A | B | C
  orderQty     Int?
  orderBy      DateTime? @db.Date
  computedAt   DateTime
  inputs       Json

  @@id([shop, variantId, scope])
  @@index([shop, status])
}

model Action {
  id          String    @id @default(cuid())
  shop        String
  kind        String    // reorder | bridge | push | fix_falling | fix_sizes | fix_page | fix_returns | clear
  variantIds  String[]
  productId   String
  amount      Decimal   @db.Decimal(18, 2)
  currency    String
  reason      Json
  state       String    @default("open") // open | snoozed | dismissed | done
  snoozeUntil DateTime?
  /// One row per (kind, product); recomputes update it in place, e.g. "reorder:gid://shopify/Product/1".
  dedupeKey   String
  /// The figure when the merchant snoozed or dismissed it (spec §7.7: comes back at 2×).
  stateAmount Decimal?  @db.Decimal(18, 2)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shop, dedupeKey])
  @@index([shop, state])
}

model MoneyAtStake {
  shop           String
  day            DateTime @db.Date
  atRisk         Decimal? @db.Decimal(18, 2) // null = not enough data ("—"), never 0
  lost90         Decimal? @db.Decimal(18, 2)
  cashStuck      Decimal? @db.Decimal(18, 2)
  soldOutTraffic Decimal? @db.Decimal(18, 2)
  basis          Json

  @@id([shop, day])
}

model Supplier {
  id            String   @id @default(cuid())
  shop          String
  name          String
  email         String?  // AES-256-GCM ciphertext (app/lib/crypto.server.ts)
  leadTimeDays  Int
  /// Minimum units per variant line (MOQ per SKU).
  minOrder      Int?
  /// Minimum total units for the whole order (optional). Kanwar 2026-10-16: both fields.
  minOrderTotal Int?
  /// Default case pack for this supplier's lines (a variant's own caseQty wins).
  casePack      Int?
  /// Days from the supplier's ship date to stock arriving (sea/air freight). Arrival = confirmed ship date + transit.
  /// leadTimeDays stays the total from order to arrival.
  transitDays   Int?
  /// Minimum order value in the supplier's currency (optional; alongside the unit minimum).
  minOrderValue Decimal? @db.Decimal(18, 2)
  /// What minOrder applies to: "variant" (each size/colour) or "product" (each style, split across its variants by sales share).
  minOrderScope String   @default("variant")
  /// 1 unit of the supplier's currency in the store's currency (optional). Without it, costs stay in store currency.
  exchangeRate  Decimal? @db.Decimal(18, 6)
  currency      String?
  vendorMatch   String[]
  /// Hide unit costs on the supplier confirmation page (spec §14).
  hidePrices    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop])
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  shop              String
  supplierId        String?   // null for Shopify POs whose supplier isn't in Keha
  status            String    // draft | sent | confirmed | received | cancelled
  number            String
  lines             Json
  confirmToken      String    @unique
  /// The confirm link stops working 60 days after the order is sent (spec §14).
  confirmExpiresAt  DateTime?
  confirmedShipDate DateTime?
  /// Lead-time based arrival estimate until the supplier confirms.
  expectedDate      DateTime? @db.Date
  source            String    // keha | shopify
  shopifyPoId       String?
  supplierName      String?   // snapshot (Shopify POs: origin.supplierName)
  currency          String?
  note              String?
  sentAt            DateTime?
  receivedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([shop, number])
  @@unique([shop, shopifyPoId])
  @@index([shop, status])
}

model Scenario {
  id          String   @id @default(cuid())
  shop        String
  name        String
  /// black_friday | christmas | custom
  event       String   @default("custom")
  start       DateTime
  end         DateTime
  targetType  String   // growth | revenue | keep_pace
  targetValue Decimal  @db.Decimal(18, 2)
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
}

model CollectionGoal {
  shop         String
  collectionId String
  goalPct      Float

  @@id([shop, collectionId])
}

model ForecastSnapshot {
  shop      String
  month     DateTime @db.Date
  variantId String
  predicted Float
  actual    Float?

  @@id([shop, month, variantId])
}

/// Collection titles for filters, the planner and collection goals (Variant.collections holds ids).
model Collection {
  id     String @id // gid://shopify/Collection/<n>
  shop   String
  title  String
  handle String

  @@index([shop])
}

/// Monthly accuracy result (spec §7.8). The rows behind it live in ForecastSnapshot.
model AccuracyMonth {
  shop          String
  month         DateTime @db.Date
  /// Absolute % error of the store total (null = not enough data).
  storeErrorPct Float?
  /// Mean absolute % error over the top 20 variants by revenue (null = not enough data).
  top20ErrorPct Float?
  graded        Int
  computedAt    DateTime @default(now())

  @@id([shop, month])
}

/// A discount Keha created from a Clear action (spec J5). Cash freed is tracked against the baseline.
model Clearance {
  id            String    @id @default(cuid())
  shop          String
  actionId      String?
  discountId    String    // gid://shopify/DiscountAutomaticNode/<n> | gid://shopify/DiscountCodeNode/<n>
  kind          String    // automatic | code
  code          String?
  percent       Int
  productIds    String[]
  variantIds    String[]
  startsAt      DateTime
  endsAt        DateTime?
  /// Cash stuck in these variants when the discount was created.
  baselineCash  Decimal   @db.Decimal(18, 2)
  baselineUnits Int
  currency      String
  createdAt     DateTime  @default(now())

  @@index([shop])
}

/// Instant alerts sent (spec §11: at most 1 per product per 7 days).
model AlertLog {
  id        String   @id @default(cuid())
  shop      String
  productId String
  kind      String   // low_best_seller | sell_out
  channel   String   // email | slack
  sentAt    DateTime @default(now())

  @@index([shop, productId, sentAt])
}

/// A stock transfer Keha created in Shopify (spec J7, Pro).
model Transfer {
  id                    String   @id @default(cuid())
  shop                  String
  shopifyTransferId     String
  originLocationId      String
  destinationLocationId String
  lines                 Json
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())

  @@index([shop])
}
